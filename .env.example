# ============================================================
# SUPERINTER S.A.S. - Variables de entorno (EJEMPLO)
# ------------------------------------------------------------
# Copia este archivo como ".env" y coloca tus credenciales reales.
# El archivo .env NUNCA debe subirse a GitHub (esta en .gitignore).
# ============================================================

# Datos de conexion a PostgreSQL local (los que configuraste en pgAdmin)
PGHOST=localhost
PGPORT=5432
PGDATABASE=superinter
PGUSER=postgres
PGPASSWORD=tu_password_aqui

# Esquema donde estan las tablas (segun el DDL)
PGSCHEMA=superinter

# Clave secreta de Flask (usada para mensajes flash y sesiones)
# Genera una con:  python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=cambia_esta_clave_por_una_aleatoria
